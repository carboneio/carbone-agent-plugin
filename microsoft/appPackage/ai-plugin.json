{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "Carbone",
  "namespace": "carbone",
  "description_for_human": "Document generation: turn your templates and data into PDF, Word, Excel and PowerPoint files.",
  "contact_email": "support@carbone.io",
  "legal_info_url": "https://carbone.io/company/terms-of-service.html",
  "privacy_policy_url": "https://carbone.io/company/privacy-policy.html",
  "functions": [],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "spec": {
        "url": "https://mcp.carbone.io"
      },
      "run_for_functions": ["*"],
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "${{CARBONE_DCR_REFERENCE_ID}}"
      }
    }
  ]
}
